@model PermissionsAdminModel.ViewModel
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col">
                @if (Model.IsAddNewButtonVisible)
                {
                    <button type="button" class="btn btn-light btn-rounded  js-add-new-button">
                        <i class="fa-solid fa-plus"></i> @Html.Raw(Model.TextAdd)
                    </button>
                }
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-body">        
        <div class="row">
            <div class="col">
                @Model.Tree.Render(Html)
            </div>
        </div>
    </div>
</div>
@section FooterSection{
    <script src="/js/admin/permissions/PermissionsAdminView.js"></script>
    <script>
    model.urlUpdate = '@Model.UrlUpdate';
    </script>
}